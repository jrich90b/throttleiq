# dependencies
# No trailing slash ON PURPOSE. A per-routine worktree symlinks node_modules in from the base
# checkout (scripts/routine_worktree.ts); `node_modules/` matches only real DIRECTORIES, so the
# symlink shows up as untracked `?? services/api/node_modules` and trips the deploy script's
# clean-tree guard ("Local services/api ... tree is dirty"). Verified 2026-08-03 in a scratch
# repo: trailing slash => `?? services/api/node_modules`, no slash => ignored.
# On the current dev box this was masked by a `node_modules` line in .git/info/exclude — which is
# LOCAL and never shared, so a fresh clone (or the deploy box) would hit it. Matching by name here
# makes the repo self-sufficient instead of depending on one machine's untracked exclude file.
node_modules

# build output
dist/
.next/
.vercel/

# env files
.env
.env.*
!.env.example

# logs
*.log
reports/

# OS files
.DS_Store

# coverage
coverage/

# local persisted dev data (conversation store)
data/

# gold-corpus incremental harvest (customer-derived; NEVER auto-commit — promotion is approve-first)
data/gold_corpus/

# HD current-catalog (scraped nightly from harley-davidson.com; runtime data, not source)
data/hd_catalog/

# production/runtime state
services/api/data/scheduler_config.json
services/api/data/google_tokens.json
services/api/data/mdf_portal_runs/
services/api/data/automation_runs.json
services/api/data/campaigns.json
services/api/data/contact_lists.json
services/api/.env
data/conversations.json

# Local-only dealer deploy profiles (real host values); commit the .example template only
infra/deploy/*.api.env

# allow lead source catalogs to be committed
!services/api/data/
!services/api/data/lead_sources/
!services/api/data/lead_sources/*.json

sample.adf.xml
.vercel

# agent skills (installed locally via npx skills)
.agents/
.claude/skills/
skills-lock.json

# worktrees Claude Code creates for `claude --worktree` / `isolation: worktree` subagents.
# (Our scheduled routines put theirs OUTSIDE the repo — see docs/routine_worktrees.md.)
.claude/worktrees/

# Marker that `scripts/routine_worktree.ts` writes at the ROOT of each per-routine worktree —
# `remove` refuses a directory without it. It necessarily lives INSIDE the checkout, so without
# this line every routine worktree starts life with an untracked file at its root: noise for a
# routine told to stage only what it changed, and one careless `git add` from being committed.
# Caught 2026-08-03 on the first real pilot run, right after #476 merged.
.throttleiq-routine-worktree
