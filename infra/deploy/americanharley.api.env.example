# Copy to infra/deploy/americanharley.api.env locally and adjust if needed.
# Do not put secrets in this file. Secrets stay in the remote API .env file.

DEPLOY_HOST=ubuntu@api.leadrider.ai
DEPLOY_REPO_URL=https://github.com/jrich90b/throttleiq.git
DEPLOY_REPO=/home/ubuntu/leadrider-api/americanharley
DEPLOY_BRANCH=main

# American Harley currently runs as the first isolated dealer API.
DEPLOY_DATA_DIR=/home/ubuntu/leadrider-runtime/americanharley/data
DEPLOY_ENV_FILE=/home/ubuntu/leadrider-runtime/americanharley/api.env
# DEPLOY_ENV_FILE is the box-side runtime env (secrets + runtime feature flags). It is NOT in
# git, and the deploy VALIDATES it rather than overwriting it — so hand-set flags survive a normal
# `npm run deploy:api`. They are only lost if this runtime env is rebuilt from scratch. Canary
# runtime flags American Harley is expected to run (re-set these on a from-scratch rebuild):
#   TURN_UNDERSTANDING_MODEL_AUTHORITY=1   # over-attachment guard (model-resolution authority); live canary, watch answer_correctness owned_bike_offered
#   WALKIN_INVENTORY_WANT_WATCH=1          # walk-in staff note that records a shopping want arms a watch (#438); Joe flipped it ON 2026-08-03. Kill switch: set 0 + `npm run deploy:api`. Tuning knob: WALKIN_INVENTORY_WANT_CONFIDENCE_MIN (default 0.8, deliberately above the parser's 0.72 accept floor — this arm mints a proactive text weeks later)
# The proactive cadence value gate (CADENCE_VALUE_GATE_ENABLED) defaults ON in code since
# 2026-07-23 — no runtime flag needed. Kill switch: set CADENCE_VALUE_GATE_ENABLED=0 in the
# runtime env file above + `npm run deploy:api`. Tuning knobs:
# CADENCE_VALUE_GATE_MIN_STEP (default 3) and CADENCE_VALUE_GATE_ENGAGED_MIN_STEP (default 1).
DEPLOY_PM2_PROCESS=throttleiq-api
# The pg-boss worker that drives background ticks when WORKER_DRIVEN_TICKS=1. Named here so the
# deploy REBUILDS and RESTARTS it — it runs `node dist/index.js`, and until 2026-07-31 the deploy
# built only the API, so the worker ran a 2026-06-10 build and three minute-lane jobs
# (task-escalations, gate-blocker-digest, photo-delivery) were silently dead after the cutover.
DEPLOY_WORKER_PM2_PROCESS=leadrider-worker-americanharley
DEPLOY_HEALTH_URL=https://api.americanharley.leadrider.ai/health
DEPLOY_REPLACE_PM2=1

# Production safety rails. These catch wrong-folder deploys and store-load
# regressions before the API can keep running against a tiny or wrong dataset.
DEPLOY_EXPECTED_DATA_DIR=/home/ubuntu/leadrider-runtime/americanharley/data
DEPLOY_MIN_CONVERSATIONS=400
DEPLOY_REQUIRED_CONVERSATION_TEXT="Michael Crosson"

# Backup retention. The deploy tars the WHOLE runtime data dir before it touches anything, then
# prunes: ONE snapshot per calendar day, kept for this many days (Joe's ruling 2026-08-19, "2
# years"). Each archive is ~1.7 GB.
#
# WHAT THE OLD KEEP-NEWEST-N RULE ACTUALLY DID, measured 2026-08-19: the API deploys 8-17x/day, so
# "newest 5" held FIVE COPIES OF ONE AFTERNOON — 9.7 GB of a 58 GB disk sitting at 94% — and nothing
# at all from any earlier day. Too many copies of today, none of last week. One-per-day keeps a
# restore point for every day ever backed up (strictly MORE history) in a fraction of the space.
#
# The prune runs AFTER the backup, so a disk this budget fills cannot be recovered by re-running the
# deploy. Check `df -h /` on the box before changing it.
DEPLOY_BACKUP_RETENTION_DAYS=730

# The base lane (throttleiq-runtime) is never deployed to, so nothing else would ever prune it —
# three of its seven tarballs were 23 May and three more 4 June. Joe's ruling covers BOTH roots.
# NOTE the decoy: <dataDir>/backups is a DIFFERENT, harmless directory — never list it here.
DEPLOY_BACKUP_EXTRA_ROOTS=/home/ubuntu/throttleiq-runtime/backups

# Keep this off for normal deploys. A dirty server means someone patched
# production manually and the drift should be reconciled first.
DEPLOY_ALLOW_DIRTY_REMOTE=0
